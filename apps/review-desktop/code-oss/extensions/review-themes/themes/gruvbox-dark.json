{
	"$schema": "vscode://schemas/color-theme",
	"name": "Whiteboard Gruvbox Dark",
	"semanticHighlighting": true,
	"tokenColors": [
		{ "scope": "comment", "settings": { "foreground": "#a89984", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage", "variable.language"], "settings": { "foreground": "#fb4934" } },
		{ "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "storage.type", "support.type", "support.class", "entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#fabd2f" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#b8bb26" } },
		{ "scope": "string", "settings": { "foreground": "#b8bb26" } },
		{ "scope": ["constant", "support.constant"], "settings": { "foreground": "#d3869b" } },
		{ "scope": "keyword.operator", "settings": { "foreground": "#ebdbb2" } },
		{ "scope": ["variable", "support.variable", "entity.name.variable", "meta.definition.variable.name", "meta.object-literal.key"], "settings": { "foreground": "#83a598" } },
		{ "scope": ["meta.embedded", "string meta.image.inline.markdown"], "settings": { "foreground": "#ebdbb2" } },
		{ "scope": "markup.inline.raw", "settings": { "foreground": "#b8bb26" } },
		{ "scope": ["markup.underline.link", "markup.underline.link.image"], "settings": { "foreground": "#83a598" } },
		{ "scope": ["markup.heading", "markup.bold"], "settings": { "foreground": "#fabd2f", "fontStyle": "bold" } },
		{ "scope": "markup.italic", "settings": { "foreground": "#d3869b", "fontStyle": "italic" } },
		{ "scope": "markup.inserted", "settings": { "foreground": "#b8bb26" } },
		{ "scope": "markup.deleted", "settings": { "foreground": "#fb4934" } }
	],
	"semanticTokenColors": {
		"type": "#fabd2f", "class": "#fabd2f", "interface": "#fabd2f",
		"function": "#b8bb26", "method": "#b8bb26", "variable": "#83a598",
		"string": "#b8bb26", "number": "#d3869b", "keyword": "#fb4934",
		"comment": "#a89984", "operator": "#ebdbb2"
	},
	"colors": {
		"foreground": "#ebdbb2",
		"descriptionForeground": "#bdae93",
		"disabledForeground": "#928374",
		"focusBorder": "#d79921",
		"textLink.foreground": "#83a598",
		"textLink.activeForeground": "#8ec07c",
		"selection.background": "#d7992140",
		"editor.background": "#282828",
		"editor.foreground": "#ebdbb2",
		"editorWidget.background": "#3c3836",
		"editorWidget.border": "#665c54",
		"editorHoverWidget.background": "#3c3836",
		"editorHoverWidget.border": "#665c54",
		"editorGutter.background": "#282828",
		"editorCursor.foreground": "#fabd2f",
		"editor.selectionBackground": "#d7992140",
		"editor.inactiveSelectionBackground": "#504945",
		"editor.lineHighlightBackground": "#32302f",
		"editorLineNumber.foreground": "#665c54",
		"editorLineNumber.activeForeground": "#bdae93",
		"editorWhitespace.foreground": "#504945",
		"editorIndentGuide.background1": "#3c3836",
		"editorIndentGuide.activeBackground1": "#665c54",
		"editorBracketMatch.background": "#d7992124",
		"editorBracketMatch.border": "#d7992170",
		"editorGroupHeader.tabsBackground": "#1d2021",
		"tab.activeBackground": "#282828",
		"tab.inactiveBackground": "#1d2021",
		"tab.activeForeground": "#ebdbb2",
		"tab.inactiveForeground": "#a89984",
		"tab.border": "#3c3836",
		"titleBar.activeBackground": "#1d2021",
		"titleBar.inactiveBackground": "#1d2021",
		"titleBar.activeForeground": "#ebdbb2",
		"sideBar.background": "#1d2021",
		"sideBar.foreground": "#ebdbb2",
		"panel.background": "#282828",
		"panel.border": "#504945",
		"panelTitle.activeBorder": "#d79921",
		"icon.foreground": "#bdae93",
		"input.background": "#3c3836",
		"input.foreground": "#ebdbb2",
		"input.border": "#665c54",
		"dropdown.background": "#3c3836",
		"dropdown.foreground": "#ebdbb2",
		"dropdown.border": "#665c54",
		"button.background": "#d79921",
		"button.foreground": "#282828",
		"button.hoverBackground": "#fabd2f",
		"list.hoverBackground": "#3c3836",
		"list.activeSelectionBackground": "#504945",
		"list.activeSelectionForeground": "#ebdbb2",
		"list.inactiveSelectionBackground": "#3c3836",
		"quickInput.background": "#282828",
		"quickInput.foreground": "#ebdbb2",
		"toolbar.hoverBackground": "#3c3836",
		"scrollbarSlider.background": "#92837473",
		"scrollbarSlider.hoverBackground": "#928374",
		"scrollbarSlider.activeBackground": "#bdae93",
		"diffEditor.insertedLineBackground": "#b8bb261f",
		"diffEditor.insertedTextBackground": "#b8bb2638",
		"diffEditor.removedLineBackground": "#fb49341f",
		"diffEditor.removedTextBackground": "#fb493438",
		"diffEditor.diagonalFill": "#665c5440",
		"diffEditor.unchangedCodeBackground": "#00000000",
		"diffEditor.unchangedRegionBackground": "#282828",
		"diffEditor.unchangedRegionForeground": "#928374",
		"multiDiffEditor.border": "#504945",
		"multiDiffEditor.headerBackground": "#1d2021",
		"gitDecoration.addedResourceForeground": "#b8bb26",
		"gitDecoration.modifiedResourceForeground": "#fabd2f",
		"gitDecoration.deletedResourceForeground": "#fb4934",
		"review.accent": "#d79921",
		"review.accentSoft": "#50402a",
		"review.onAccent": "#282828",
		"review.onWarning": "#282828",
		"review.well": "#3c3836",
		"review.raised": "#3c3836",
		"review.tray": "#1d2021",
		"review.ghost": "#504945",
		"review.agent1": "#d3869b",
		"review.agent2": "#8ec07c",
		"review.grid": "#3c3836",
		"review.edgeMuted": "#928374",
		"review.mapStorageBorder": "#83a598",
		"review.added": "#b8bb26",
		"review.removed": "#fb4934",
		"review.modified": "#fabd2f",
		"review.diffAddedBackground": "#353a28",
		"review.diffRemovedBackground": "#422c29",
		"review.diffModifiedBackground": "#403a29",
		"review.syntaxComment": "#a89984",
		"review.syntaxType": "#fabd2f",
		"review.syntaxFunction": "#b8bb26",
		"review.syntaxString": "#b8bb26",
		"review.syntaxNumber": "#d3869b",
		"review.syntaxOperator": "#ebdbb2"
	}
}
