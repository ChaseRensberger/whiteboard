{
	"$schema": "vscode://schemas/color-theme",
	"name": "Whiteboard Gruvbox Light",
	"semanticHighlighting": true,
	"tokenColors": [
		{ "scope": "comment", "settings": { "foreground": "#7c6f64", "fontStyle": "italic" } },
		{ "scope": ["keyword", "storage", "variable.language"], "settings": { "foreground": "#9d0006" } },
		{ "scope": ["entity.name.type", "entity.name.class", "entity.name.namespace", "entity.other.inherited-class", "storage.type", "support.type", "support.class", "entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#8f3f71" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#79740e" } },
		{ "scope": "string", "settings": { "foreground": "#79740e" } },
		{ "scope": ["constant", "support.constant"], "settings": { "foreground": "#8f3f71" } },
		{ "scope": "keyword.operator", "settings": { "foreground": "#3c3836" } },
		{ "scope": ["variable", "support.variable", "entity.name.variable", "meta.definition.variable.name", "meta.object-literal.key"], "settings": { "foreground": "#076678" } },
		{ "scope": ["meta.embedded", "string meta.image.inline.markdown"], "settings": { "foreground": "#3c3836" } },
		{ "scope": "markup.inline.raw", "settings": { "foreground": "#79740e" } },
		{ "scope": ["markup.underline.link", "markup.underline.link.image"], "settings": { "foreground": "#076678" } },
		{ "scope": ["markup.heading", "markup.bold"], "settings": { "foreground": "#af3a03", "fontStyle": "bold" } },
		{ "scope": "markup.italic", "settings": { "foreground": "#8f3f71", "fontStyle": "italic" } },
		{ "scope": "markup.inserted", "settings": { "foreground": "#79740e" } },
		{ "scope": "markup.deleted", "settings": { "foreground": "#9d0006" } }
	],
	"semanticTokenColors": {
		"type": "#8f3f71", "class": "#8f3f71", "interface": "#8f3f71",
		"function": "#79740e", "method": "#79740e", "variable": "#076678",
		"string": "#79740e", "number": "#8f3f71", "keyword": "#9d0006",
		"comment": "#7c6f64", "operator": "#3c3836"
	},
	"colors": {
		"foreground": "#3c3836",
		"descriptionForeground": "#7c6f64",
		"disabledForeground": "#928374",
		"focusBorder": "#af3a03",
		"textLink.foreground": "#076678",
		"textLink.activeForeground": "#427b58",
		"selection.background": "#af3a0340",
		"editor.background": "#fbf1c7",
		"editor.foreground": "#3c3836",
		"editorWidget.background": "#f9f5d7",
		"editorWidget.border": "#d5c4a1",
		"editorHoverWidget.background": "#f9f5d7",
		"editorHoverWidget.border": "#d5c4a1",
		"editorGutter.background": "#fbf1c7",
		"editorCursor.foreground": "#af3a03",
		"editor.selectionBackground": "#af3a0330",
		"editor.inactiveSelectionBackground": "#ebdbb2",
		"editor.lineHighlightBackground": "#f2e5bc",
		"editorLineNumber.foreground": "#bdae93",
		"editorLineNumber.activeForeground": "#7c6f64",
		"editorWhitespace.foreground": "#d5c4a1",
		"editorIndentGuide.background1": "#ebdbb2",
		"editorIndentGuide.activeBackground1": "#bdae93",
		"editorBracketMatch.background": "#af3a0324",
		"editorBracketMatch.border": "#af3a0370",
		"editorGroupHeader.tabsBackground": "#ebdbb2",
		"tab.activeBackground": "#fbf1c7",
		"tab.inactiveBackground": "#ebdbb2",
		"tab.activeForeground": "#3c3836",
		"tab.inactiveForeground": "#7c6f64",
		"tab.border": "#d5c4a1",
		"titleBar.activeBackground": "#ebdbb2",
		"titleBar.inactiveBackground": "#ebdbb2",
		"titleBar.activeForeground": "#3c3836",
		"sideBar.background": "#f2e5bc",
		"sideBar.foreground": "#3c3836",
		"panel.background": "#fbf1c7",
		"panel.border": "#d5c4a1",
		"panelTitle.activeBorder": "#af3a03",
		"icon.foreground": "#7c6f64",
		"input.background": "#ebdbb2",
		"input.foreground": "#3c3836",
		"input.border": "#d5c4a1",
		"dropdown.background": "#f9f5d7",
		"dropdown.foreground": "#3c3836",
		"dropdown.border": "#d5c4a1",
		"button.background": "#af3a03",
		"button.foreground": "#fbf1c7",
		"button.hoverBackground": "#9d0006",
		"list.hoverBackground": "#ebdbb2",
		"list.activeSelectionBackground": "#d5c4a1",
		"list.activeSelectionForeground": "#3c3836",
		"list.inactiveSelectionBackground": "#ebdbb2",
		"quickInput.background": "#fbf1c7",
		"quickInput.foreground": "#3c3836",
		"toolbar.hoverBackground": "#ebdbb2",
		"scrollbarSlider.background": "#92837473",
		"scrollbarSlider.hoverBackground": "#928374",
		"scrollbarSlider.activeBackground": "#7c6f64",
		"diffEditor.insertedLineBackground": "#79740e1f",
		"diffEditor.insertedTextBackground": "#79740e38",
		"diffEditor.removedLineBackground": "#9d00061f",
		"diffEditor.removedTextBackground": "#9d000638",
		"diffEditor.diagonalFill": "#bdae9340",
		"diffEditor.unchangedCodeBackground": "#00000000",
		"diffEditor.unchangedRegionBackground": "#fbf1c7",
		"diffEditor.unchangedRegionForeground": "#928374",
		"multiDiffEditor.border": "#d5c4a1",
		"multiDiffEditor.headerBackground": "#ebdbb2",
		"gitDecoration.addedResourceForeground": "#79740e",
		"gitDecoration.modifiedResourceForeground": "#b57614",
		"gitDecoration.deletedResourceForeground": "#9d0006",
		"review.accent": "#af3a03",
		"review.accentSoft": "#f2e5bc",
		"review.onAccent": "#fbf1c7",
		"review.onWarning": "#1d2021",
		"review.well": "#ebdbb2",
		"review.raised": "#f9f5d7",
		"review.tray": "#f2e5bc",
		"review.ghost": "#d5c4a1",
		"review.agent1": "#8f3f71",
		"review.agent2": "#427b58",
		"review.grid": "#ebdbb2",
		"review.edgeMuted": "#928374",
		"review.mapStorageBorder": "#076678",
		"review.added": "#79740e",
		"review.removed": "#9d0006",
		"review.modified": "#b57614",
		"review.diffAddedBackground": "#edf0c1",
		"review.diffRemovedBackground": "#f4dfbb",
		"review.diffModifiedBackground": "#f5e8b8",
		"review.syntaxComment": "#7c6f64",
		"review.syntaxType": "#8f3f71",
		"review.syntaxFunction": "#79740e",
		"review.syntaxString": "#79740e",
		"review.syntaxNumber": "#8f3f71",
		"review.syntaxOperator": "#3c3836"
	}
}
